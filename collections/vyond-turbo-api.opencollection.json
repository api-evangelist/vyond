          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/rest/v1/turbo/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the status and download URL of a Turbo video generation task by ID"
        }
      ]
    }
  ],
